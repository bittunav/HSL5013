    "import numpy as np\n",
    "\n",
    "Sigma=np.array([\n",
    "    [.0625,.0625,.09375],\n",
    "    [.0625,.2500,.28125],\n",
    "    [.09375,.28125,.5625]\n",
    "])\n",
    "\n",
    "A=np.linalg.cholesky(Sigma)\n",
    "print(A)\n",
    "print(A @ A.T)"
